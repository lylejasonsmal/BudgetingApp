@namespace UI.Pages
@inject ExpenseRepository ExpenseRepository
@inject IMonthlyBudgetFixtureService MonthlyBudgetFixtureService
@inject IToastService ToastService
@page "/"

<div class="page">
    <BudgetFixtureComponent />
    

    <button class="floating-button" @onclick="OpenAddExpensePopup">
        <MaterialDesignIconComponent IconName="add" />
    </button>

    @if (_expenseIds is not null && _expenseIds.Count > 0)
    {
        <h1 id="expenses">Expenses</h1>
        <p>@_expenseIds.Count expense(s) listed</p>

        @foreach (var expenseId in _expenseIds)
        {
            <ExpenseComponent Id="@expenseId"/>
        }
    }
    else
    {
        <div id="expenses" class="no-expenses-container">
            <MaterialDesignIconComponent IconName="wallet"/>
            <h1>Hey There!</h1>
            <p class="secondary-text">I notice you currently have no expenses listed. Get started with your budgeting journey today! Add your first expense and take control of your finances.</p>
            <button @onclick="OpenAddExpensePopup">Add Expense</button>
        </div>
    }

    <div id="savings" class="no-savings-container">
        <MaterialDesignIconComponent IconName="savings"/>
        <h1>Start Saving!</h1>
        <p class="secondary-text">Add a savings pocket and work towards your dreams!</p>
        <button @onclick="OpenAddSavingsPocketPopup">Add Savings Pocket</button>
    </div>

    <AddExpensePopupComponent @bind-Visible="_showPopup"/>
</div>

@code
{
    private IReadOnlyList<int>? _expenseIds;
    private bool _showPopup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await MonthlyBudgetFixtureService.SubscribeAsync(async model =>
        {
            _expenseIds = await ExpenseRepository.GetExpenseIdsByFixtureIdAsync(model.Id);
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OpenAddExpensePopup()
    {
        _showPopup = true;
    }

    private async Task OpenAddSavingsPocketPopup()
    {
        await ToastService.ShowFailureToastAsync("Not Supported Yet. Coming Soon!");
    }


}
