@namespace UI.Pages
@inject ExpenseRepository ExpenseRepository
@inject IMonthlyBudgetFixtureService MonthlyBudgetFixtureService
@inject IToastService ToastService
@page "/"
@using MyFirstApp.Domain.Enums

<div class="page">
    <BudgetFixtureComponent />
    

    <button class="floating-button" @onclick="OpenAddExpensePopup">
        <MaterialDesignIconComponent IconName="add" />
    </button>

    @if (_expenseIds is not null && _expenseIds.Count > 0)
    {
        <CardWrapperComponent HeaderText="Expenses" IsLargeText="true">
            <div class="expenses-container">
                <div class="info-card">
                    Filter & sort by your preferences:
                    <button class="secondary-button" @onclick="OpenFilterPanelAsync">
                        <MaterialDesignIconComponent IconName="tune"/>
                        <strong>@_appliedFilters.Count filter(s) applied</strong>
                    </button>
                </div>

                @foreach (var expenseId in _expenseIds)
                {
                    <ExpenseComponent @key="expenseId" Id="@expenseId"/>
                }
            </div>
        </CardWrapperComponent>
    }
    else
    {
        
        <CardWrapperComponent HeaderText="Expenses" IsLargeText="true">
        <div id="expenses" class="no-expenses-container">
            <MaterialDesignIconComponent IconName="wallet"/>
            <h1>Hey There!</h1>
            <p class="secondary-text">I notice you currently have no expenses listed. Get started with your budgeting journey today! Add your first expense and take control of your finances.</p>
            <button @onclick="OpenAddExpensePopup">Add Expense</button>
            @if (_appliedFilters.Count > 0)
            {
                <button class="secondary-button" @onclick="OpenFilterPanelAsync">
                    <MaterialDesignIconComponent IconName="tune"/>
                    <strong>@_appliedFilters.Count filter(s) applied</strong>
                </button>
            }
        </div>
        </CardWrapperComponent>
    }
    
    
    <CardWrapperComponent HeaderText="Savings" IsLargeText="true">
        <div id="savings" class="no-savings-container">
            <MaterialDesignIconComponent IconName="savings"/>
            <h1>Start Saving!</h1>
            <p class="secondary-text">Add a savings pocket and work towards your dreams!</p>
            <button @onclick="OpenAddSavingsPocketPopup">Add Savings Pocket</button>
        </div>
    </CardWrapperComponent>
    <AddExpensePopupComponent @bind-Visible="_showPopup"/>
</div>

<PopupWrapperComponent @bind-Visible="_openFiltersPanel" HeaderText="Filter Your Expenses">
    <h1>
        Apply Filters
    </h1>
    <p class="caption">Improve your user experience</p>
    
    <div class="popup-actions">
        <button @onclick="ApplyFiltersAsync">
            Apply Filters
            <MaterialDesignIconComponent IconName="done_all"/>
        </button>
        @if (_appliedFilters.Count > 0)
        {
            <button class="error" @onclick="ClearFiltersAsync">
                Clear
                <MaterialDesignIconComponent IconName="clear"/>
            </button>
        }
    </div>

    <p>Sort by:</p>
    <button class="@(_appliedFilters.Contains(ExpenseFilters.PaidExpensesFirst) ? "": "secondary-button")" @onclick="() => ToggleFilterAsync(ExpenseFilters.PaidExpensesFirst)">
        Paid Expenses (Ascending)
    </button>
    <button class="@(_appliedFilters.Contains(ExpenseFilters.PaidExpensesLast) ? "": "secondary-button")" @onclick="() => ToggleFilterAsync(ExpenseFilters.PaidExpensesLast)">
        Paid Expenses (Descending)
    </button>
    <button class="@(_appliedFilters.Contains(ExpenseFilters.AlphabeticalOrder) ? "" : "secondary-button")" @onclick="() => ToggleFilterAsync(ExpenseFilters.AlphabeticalOrder)">
        Alphabetical Order (A - Z)
    </button>
    <button class="@(_appliedFilters.Contains(ExpenseFilters.ReverseAlphabeticalOrder) ? "" : "secondary-button")" @onclick="() => ToggleFilterAsync(ExpenseFilters.ReverseAlphabeticalOrder)">
        Reverse Alphabetical Order (Z - A)
    </button>

    <p>Filter by:</p>
    <button class="@(_appliedFilters.Contains(ExpenseFilters.PaidExpensesOnly) ? "": "secondary-button")" @onclick="() => ToggleFilterAsync(ExpenseFilters.PaidExpensesOnly)" >
        Paid Expenses Only
    </button>
    <button class="@(_appliedFilters.Contains(ExpenseFilters.UnpaidExpensesOnly) ? "": "secondary-button")" @onclick="() => ToggleFilterAsync(ExpenseFilters.UnpaidExpensesOnly)">
        Unpaid Expenses Only
    </button>
</PopupWrapperComponent>
@code
{
    private IReadOnlyList<int>? _expenseIds;
    private bool _showPopup;
    private bool _openFiltersPanel;
    private MonthlyBudgetFixtureModel? _budgetFixtureModel;
    private readonly IList<ExpenseFilters> _appliedFilters = new List<ExpenseFilters>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await MonthlyBudgetFixtureService.SubscribeAsync(async model =>
        {
            _budgetFixtureModel = model;
            _expenseIds = await ExpenseRepository.ApplyFiltersAsync(model.Id, _appliedFilters);

            await InvokeAsync(StateHasChanged);
        });
    }

    private void OpenAddExpensePopup()
    {
        _showPopup = true;
    }

    private async Task OpenAddSavingsPocketPopup()
    {
        await ToastService.ShowFailureToastAsync("Not Supported Yet. Coming Soon!");
    }

    private async Task OpenFilterPanelAsync()
    {
        _openFiltersPanel = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyFiltersAsync()
    {
        _expenseIds = await ExpenseRepository.ApplyFiltersAsync(_budgetFixtureModel?.Id, _appliedFilters);
        _openFiltersPanel = false;
        await ToastService.ShowSuccessToastAsync($"{_appliedFilters.Count} filter(s) applied.");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearFiltersAsync()
    {
        _appliedFilters.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleFilterAsync(ExpenseFilters filter)
    {
        if (_appliedFilters.Contains(filter))
        {
            _appliedFilters.Remove(filter);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_appliedFilters.Contains(ExpenseFilters.PaidExpensesFirst) && filter == ExpenseFilters.PaidExpensesLast)
        {
            _appliedFilters.Remove(ExpenseFilters.PaidExpensesFirst);
        }
        if (_appliedFilters.Contains(ExpenseFilters.PaidExpensesLast) && filter == ExpenseFilters.PaidExpensesFirst)
        {
            _appliedFilters.Remove(ExpenseFilters.PaidExpensesLast);
        }
        if (_appliedFilters.Contains(ExpenseFilters.PaidExpensesOnly) && filter == ExpenseFilters.UnpaidExpensesOnly)
        {
            _appliedFilters.Remove(ExpenseFilters.PaidExpensesOnly);
        }
        if (_appliedFilters.Contains(ExpenseFilters.UnpaidExpensesOnly) && filter == ExpenseFilters.PaidExpensesOnly)
        {
            _appliedFilters.Remove(ExpenseFilters.UnpaidExpensesOnly);
        }
        if (_appliedFilters.Contains(ExpenseFilters.ReverseAlphabeticalOrder) && filter == ExpenseFilters.AlphabeticalOrder)
        {
            _appliedFilters.Remove(ExpenseFilters.ReverseAlphabeticalOrder);
        }
        if (_appliedFilters.Contains(ExpenseFilters.AlphabeticalOrder) && filter == ExpenseFilters.ReverseAlphabeticalOrder)
        {
            _appliedFilters.Remove(ExpenseFilters.AlphabeticalOrder);
        }

        _appliedFilters.Add(filter);
        await InvokeAsync(StateHasChanged);
    }


}
