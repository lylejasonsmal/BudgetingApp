@namespace UI.Pages
@inject ExpenseRepository ExpenseRepository
@inject IMonthlyBudgetFixtureService MonthlyBudgetFixtureService
@page "/"

<div class="page">
    @if (_currentBudgetFixtureId is not null)
    {
        <BudgetFixtureComponent Id="@_currentBudgetFixtureId.Value"/>
    }
    

    <button class="floating-button" @onclick="OpenAddExpensePopupAsync">
        <MaterialDesignIconComponent IconName="add" />
    </button>

    @if (_expenseIds is not null && _expenseIds.Count > 0)
    {
        <h1 id="expenses">Expenses</h1>
        <p>@_expenseIds.Count expenses listed</p>

        @foreach (var expenseId in _expenseIds)
        {
            <ExpenseComponent Id="@expenseId"/>
        }
    }
    else
    {
        <div id="expenses" class="no-expenses-container">
            <MaterialDesignIconComponent IconName="wallet"/>
            <h1>Hey There!</h1>
            <p>I notice you currently have no expenses listed. Get started with your budgeting journey today! Add your first expense and take control of your finances.</p>
            <button @onclick="OpenAddExpensePopupAsync">Add Expense</button>
        </div>
    }

    <div id="savings" class="no-savings-container">
        <MaterialDesignIconComponent IconName="savings"/>
        <h1>Start Saving!</h1>
        <p>Add a savings pocket and work towards your dreams!</p>
        <button>Add Savings Pocket (Not Supported Yet)</button>
    </div>

    <AddExpensePopupComponent @bind-Visible="_showPopup"/>
</div>

@code
{
    private IReadOnlyList<int>? _expenseIds;
    private int? _currentBudgetFixtureId;
    private bool _showPopup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await MonthlyBudgetFixtureService.SubscribeAsync(async model =>
        {
            _currentBudgetFixtureId = model.Id;

            if (_currentBudgetFixtureId is not null)
            {
                _expenseIds = await ExpenseRepository.GetExpenseIdsByFixtureIdAsync(_currentBudgetFixtureId);
            }

            await InvokeAsync(StateHasChanged);
        });
    }

    private void OpenAddExpensePopupAsync()
    {
        _showPopup = true;
    }


}
