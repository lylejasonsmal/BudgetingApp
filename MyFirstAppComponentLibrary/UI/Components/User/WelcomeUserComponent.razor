@namespace MyFirstAppComponentLibrary.UI.Components
@inject UserRepository UserRepository

@if (_user is not null)
{
    <CardWrapperComponent>
        <div class="card-body">
            @if (_user.ProfileImage is not null && _profileImageSrc is not null)
            {
                <img src="@_profileImageSrc" class="image" />
            }
            <h3 class="large-text">Hey, @_user.FirstName</h3>
            <p class="secondary-text">Fancy seeing you here! ;)</p>
        </div>
        <BudgetFixtureInsightsComponent/>
    </CardWrapperComponent>
}

@code {
    private UserModel? _user;
    private string? _profileImageSrc;

    protected override async Task OnInitializedAsync()
    {
        if (_user is not null) return;
        _user = await UserRepository.GetByIdAsync(1);
        _ = ConvertUserImage();

    }

    private async Task ConvertUserImage()
    {
        if (_user!.ProfileImage != null)
        {
            _profileImageSrc = $"data:image/png;base64,{Convert.ToBase64String(_user.ProfileImage)}";
        }
        await InvokeAsync(StateHasChanged);
    }

}
