@inject IToastService ToastService
<PopupWrapperComponent @bind-Visible="Visible" HeaderText="Celebrating Your Life!">
    <div class="birthday-confetti">
        <h1 class="large-text">Happy Birthday!</h1>
        <button @onclick="ThankYouAsync">Thank You!</button>
    </div>
</PopupWrapperComponent>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private async Task ThankYouAsync()
    {
        await ToastService.ShowSuccessToastAsync("Thank you!");
    }
}
