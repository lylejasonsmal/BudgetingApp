@namespace MyFirstAppComponentLibrary.UI.Components
@inject IJSRuntime JS
@inject IToastService ToastService

<CardWrapperComponent HeaderText="App Settings" IsLargeText="true" IconName="settings">
    <div class="card-body">
        <div class="info-card">
            <h6>@(_isDarkMode ? "Dark Mode" : "Light Mode")</h6>

            <button @onclick="ToggleThemeAsync">
                <MaterialDesignIconComponent IconName="@(_isDarkMode ? "light_mode" : "dark_mode")" />
            </button>
        </div>

        <div class="info-card">
            <div>
                <h6>Current Font</h6>
                <p class="secondary-text">@($"{_fonts[_currentFontIndex]}")</p>
            </div>

            <div>
                @foreach (var font in _fonts)
                {
                    @if (font != _fonts[_currentFontIndex])
                    {
                        <button style="font-family: @font;" @onclick="() => SetCurrentFontAsync(font)">
                            @($"Switch To '{font}'")
                        </button>
                    }
                }
            </div>
        </div>
        
        <div class="info-card">
            <h6>Experimental</h6>
            <MaterialDesignIconComponent IconName="experiment"/>
        </div>

        <button @onclick="ToggleExperimentalThemeAsync" style="display: none;">
            @(_isExperimental ? "Reset" : "Experiment")
        </button>
    </div>
</CardWrapperComponent>

@code {
    private bool _isDarkMode = true;
    private int _currentFontIndex;
    private bool _isExperimental;

    private readonly string[] _fontClassNames = ["default-font", "secondary-font", "tertiary-font", "quaternary-font"];
    private readonly string[] _fonts = ["Poppins", "Borel", "Kanit", "Montserrat"];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await JS.InvokeAsync<string>("getSavedTheme");

            if (!string.IsNullOrEmpty(savedTheme))
            {
                _isDarkMode = savedTheme == "dark-theme";
                await JS.InvokeVoidAsync("setTheme", savedTheme);
            }

            var savedFont = await JS.InvokeAsync<string>("getSavedFont");
            if (!string.IsNullOrEmpty(savedFont))
            {
                _currentFontIndex = Array.IndexOf(_fontClassNames, savedFont);
                if (_currentFontIndex == -1) _currentFontIndex = 0;
                await JS.InvokeVoidAsync("setFont", _fontClassNames[_currentFontIndex]);
            }

            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        var theme = _isDarkMode ? "dark-theme" : "light-theme";
        await JS.InvokeVoidAsync("setTheme", theme);
    }

    private async Task SetCurrentFontAsync(string font)
    {
        var index = Array.IndexOf(_fonts, font);
        _currentFontIndex = index;
        await JS.InvokeVoidAsync("setFont", _fontClassNames[index]);
        await InvokeAsync(StateHasChanged);
        await ToastService.ShowSuccessToastAsync($"Changed your default font to '{_fonts[index]}' !");
    }

    private async Task ToggleExperimentalThemeAsync()
    {
        _isExperimental = !_isExperimental;
        var experimental = _isExperimental ? "experimental" : "";
        await JS.InvokeVoidAsync("setExperimentalTheme", experimental);
    }
}
