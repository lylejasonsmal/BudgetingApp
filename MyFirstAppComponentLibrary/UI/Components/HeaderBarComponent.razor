@inject IToastService ToastService
@inject IUserService UserService
@inject IConnectivityService ConnectivityService
@inject UserRepository UserRepository
@inject NavigationManager NavigationManager
@namespace MyFirstAppComponentLibrary.UI.Components

<div class="header-bar">
    @if (_user is not null)
    {
        <div class="user-container" @onclick="GoToProfile">

            @if (string.IsNullOrWhiteSpace(_profileImageSrc))
            {
                <div class="image-placeholder">
                    <MaterialDesignIconComponent IconName="person"/>
                </div>
            }
            else
            {
                <img src="@_profileImageSrc"/>
            }

            <strong>@(string.IsNullOrWhiteSpace(_user.Username) ? _user.FirstName : _user.Username)</strong>

            <MaterialDesignIconComponent IconName="chevron_right"/>
        </div>
    }
    <div>
        <MaterialDesignIconComponent IconName="@(_isOnline ? "android_wifi_4_bar" : "android_wifi_4_bar_off")" />
    </div>
    
    
    
    <div @onclick="@(() => NavigationManager.NavigateTo("/developer"))">
        <MaterialDesignIconComponent IconName="developer_board" />
    </div>
</div>
<HappyBirthdayComponent @bind-Visible="_isUserBirthdayToday"/>

@code {
    private UserModel? _user;
    private string? _profileImageSrc;
    private bool _isUserBirthdayToday;
    private bool _isOnline;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await UserService.SubscribeAsync(async model =>
        {
            _user = model;
            if (_user.ProfileImage != null)
            {
                _profileImageSrc = $"data:image/png;base64,{Convert.ToBase64String(_user.ProfileImage)}";
            }
            else
            {
                _profileImageSrc = null;
            }

            if (_user.Birthday is not null &&
                _user.Birthday.Value.Month == DateTime.Today.Month &&
                _user.Birthday.Value.Day == DateTime.Today.Day)
            {
                _isUserBirthdayToday = true;
            }
            await InvokeAsync(StateHasChanged);
        });

        await ConnectivityService.SubscribeAsync(async connectivity =>
        {
            _isOnline = connectivity;
            if (_isOnline) await ToastService.ShowSuccessToastAsync("Online");
            if (!_isOnline) await ToastService.ShowFailureToastAsync("Your Internet Connection Is Lost");
            await InvokeAsync(StateHasChanged);
        });

        _isOnline = await ConnectivityService.CheckConnectivityAsync();

        _user = await UserRepository.GetByIdAsync(1);

        if (_user?.ProfileImage != null)
        {
            _profileImageSrc = $"data:image/png;base64,{Convert.ToBase64String(_user.ProfileImage)}";
        }

        if (_user?.Birthday is not null &&
            _user.Birthday.Value.Month == DateTime.Today.Month &&
            _user.Birthday.Value.Day == DateTime.Today.Day)
        {
            _isUserBirthdayToday = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void GoToProfile()
    {
        NavigationManager.NavigateTo("/profile");
    }
}