@namespace MyFirstAppComponentLibrary.UI.Components
@inject IMonthlyBudgetFixtureService MonthlyBudgetFixtureService

<CardWrapperComponent HeaderText="@DateTime.Today.ToString("MMMM")" IconName="edit" IsLargeText="true" OnIconClick="OpenPopupAsync">
    <div class="card-body">
        @if (_budgetFixture is not null)
        {
            <h6>Summary</h6>
            <div class="info-card">
                <p class="secondary-text">Net Salary</p>
                <h6>R@_budgetFixture.StoredNetSalary</h6>
            </div>

            <div class="info-card">
                <p class="secondary-text">Budgeted For</p>
                <h6>R@_budgetFixture.BudgetedForAmount</h6>
            </div>

            <div class="info-card">
                <p class="secondary-text">Actual Expenditure</p>
                <h6>R@(_budgetFixture.StoredNetSalary - _budgetFixture.LeftOverAmount)</h6>
            </div>

            <div class="info-card">
                <p class="secondary-text">Amount Left Over</p>
                <h1>R@_budgetFixture.LeftOverAmount</h1>
            </div>
            <p class ="secondary-text">Stay up-to-date with <strong>your budget</strong>.</p>
        }
        else
        {
            <div>
                <MaterialDesignIconComponent IconName="account_balance_wallet"/>
                <h1 class="large-text">Get Started</h1>
                <p class="secondary-text">Get your budgeting journey started by setting your account with the necessary details.</p>
                <button @onclick="OpenPopupAsync">Setup Budget</button>
            </div>
        }
    </div>
</CardWrapperComponent>

    <EditBudgetFixtureComponent @bind-Visible="_showPopup"/>


@code {
    private MonthlyBudgetFixtureModel? _budgetFixture;
    private bool _showPopup;

    protected override async Task OnParametersSetAsync()
    {
        await MonthlyBudgetFixtureService.SubscribeAsync(async model =>
        {
            _budgetFixture = model;
            await InvokeAsync(StateHasChanged);
        });

        _budgetFixture = await MonthlyBudgetFixtureService.GetCurrentFixtureAsync();
    }

    private void OpenPopupAsync()
    {
        _showPopup = true;
    }
}
