@using MyFirstAppComponentLibrary.UI.Components.MonthlyBudgetFixture
@namespace MyFirstAppComponentLibrary.UI.Components
@inject IMonthlyBudgetFixtureService MonthlyBudgetFixtureService
@inject ExpenseRepository ExpenseRepository

<CardWrapperComponent HeaderText="@DateTime.Today.ToString("MMMM")" IconName="edit" IsLargeText="true" OnIconClick="OpenPopupAsync">
    <div class="card-body">
        @if (_budgetFixture is not null)
        {
            <h6>Summary</h6>
            <div class="info-card">
                <p class="secondary-text">Net Salary</p>
                <h6>R@_budgetFixture.StoredNetSalary</h6>
            </div>

            <div class="info-card">
                <p class="secondary-text">Budgeted For</p>
                <h6>R@_budgetFixture.BudgetedForAmount</h6>
            </div>

            <div class="info-card">
                <p class="secondary-text">Actual Expenditure</p>
                <h6>R@(_budgetFixture.StoredNetSalary - _budgetFixture.LeftOverAmount)</h6>
            </div>

            <div class="info-card">
                <p class="secondary-text">Amount Left Over</p>
                <h1>R@_budgetFixture.LeftOverAmount</h1>
            </div>

            @if (_budgetFixture.NumberOfExpenses > 0)
            {
                <h6>Insights</h6>
                <div class="info-card">
                    <MaterialDesignIconComponent IconName="analytics"/>
                    <p>
                        This is where your budget insights will go
                    </p>
                </div>

                <div class="info-card">
                    <MaterialDesignIconComponent IconName="paid"/>
                    <p>
                        <strong>@_paidExpenseCount</strong> out of <strong>@_budgetFixture.NumberOfExpenses</strong> expenses are paid for.
                        <ProgressBarComponent Total="_budgetFixture.NumberOfExpenses!.Value" Progress="_paidExpenseCount"/>
                    </p>
                </div>

                <div class="info-card">
                    <MaterialDesignIconComponent IconName="trending_down"/>
                    <p>
                        <strong>@_overBudgetCount</strong> out of <strong>@_budgetFixture.NumberOfExpenses</strong> expenses are overbudget.
                        <ProgressBarComponent Total="_budgetFixture.NumberOfExpenses!.Value" Progress="_overBudgetCount" IsDanger="true"/>
                    </p>
                </div>
            }
        }
        else
        {
            <div>
                <MaterialDesignIconComponent IconName="account_balance_wallet"/>
                <h1 class="large-text">Get Started</h1>
                <p class="secondary-text">Get your budgeting journey started by setting your account with the necessary details.</p>
                <button @onclick="OpenPopupAsync">Setup Budget</button>
            </div>
        }
    </div>
</CardWrapperComponent>

    <EditBudgetFixtureComponent @bind-Visible="_showPopup"/>


@code {
    private MonthlyBudgetFixtureModel? _budgetFixture;
    private int _paidExpenseCount;
    private int _overBudgetCount;
    private bool _showPopup;

    protected override async Task OnParametersSetAsync()
    {
        await MonthlyBudgetFixtureService.SubscribeAsync(async model =>
        {
            _budgetFixture = model;
            if (_budgetFixture is null) return;
            _paidExpenseCount = await ExpenseRepository.GetPaidExpenseCount(model.Id);
            _overBudgetCount = await ExpenseRepository.GetOverBudgetExpenseCount(model.Id);
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OpenPopupAsync()
    {
        _showPopup = true;
    }
}
