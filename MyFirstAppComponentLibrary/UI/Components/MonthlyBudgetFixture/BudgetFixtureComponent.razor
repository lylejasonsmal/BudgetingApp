@namespace MyFirstAppComponentLibrary.UI.Components
@inject IMonthlyBudgetFixtureService MonthlyBudgetFixtureService
@inject ExpenseRepository ExpenseRepository

@if (_budgetFixture is not null)
{
    <CardWrapperComponent HeaderText="@_budgetFixture.Month" IconName="calendar_month" Link="/statistics-dashboard" IsLargeText="true">
        <div class="card-body">
            <div class="info-card">
                <p>Net Salary</p>
                <h2>R@_budgetFixture.StoredNetSalary</h2>
            </div>
            
            <h6>Summary</h6>
            <div class="info-card">
                <p>Budgeted For</p>
                <h2>R@_budgetFixture.BudgetedForAmount</h2>
            </div>

            <div class="info-card">
                <p>Actual Expenditure</p>
                <h2>R@(_budgetFixture.StoredNetSalary - _budgetFixture.LeftOverAmount)</h2>
            </div>

            <div class="info-card">
                <p>Amount Left Over</p>
                <h2>R@_budgetFixture.LeftOverAmount</h2>
            </div>
            
            <div class="info-card">
                <h2>View</h2>
                <div class="card-body">
                    <a href="#expenses" class="link">Expenses</a>
                    <a href="#savings">Savings</a>
                </div>
            </div>
            
            @if (_budgetFixture.NumberOfExpenses > 0)
            {
                <h6>Insights</h6>
                <div class="info-card">
                    <MaterialDesignIconComponent IconName="analytics"/>
                    <p>This is where insights about your monthly budget will go.</p>
                </div>

                <div class="info-card">
                    <MaterialDesignIconComponent IconName="paid"/>
                    <p>
                        <strong>@_paidExpenseCount</strong> out of <strong>@_budgetFixture.NumberOfExpenses</strong> expenses are paid for.
                        <ProgressBarComponent Total="_budgetFixture.NumberOfExpenses!.Value" Progress="_paidExpenseCount"/>
                    </p>
                </div>

                <div class="info-card">
                    <MaterialDesignIconComponent IconName="trending_down"/>
                    <p>
                        <strong>@_overBudgetCount</strong> out of <strong>@_budgetFixture.NumberOfExpenses</strong> expenses are overbudget.
                        <ProgressBarComponent Total="_budgetFixture.NumberOfExpenses!.Value" Progress="_overBudgetCount" IsDanger="true"/>
                    </p>
                </div>
            }
        </div>
    </CardWrapperComponent>
}
else
{
    <CardWrapperComponent IsLoading="true">
    </CardWrapperComponent>
}

@code {
    [Parameter] public required int Id { get; set; }
    private MonthlyBudgetFixtureModel? _budgetFixture;
    private int _paidExpenseCount;
    private int _overBudgetCount;

    protected override async Task OnParametersSetAsync()
    {
        await MonthlyBudgetFixtureService.SubscribeAsync(async model =>
        {
            _budgetFixture = model;
            _paidExpenseCount = await ExpenseRepository.GetPaidExpenseCount(Id);
            _overBudgetCount = await ExpenseRepository.GetOverBudgetExpenseCount(Id);
            await InvokeAsync(StateHasChanged);
        });
     }
}
