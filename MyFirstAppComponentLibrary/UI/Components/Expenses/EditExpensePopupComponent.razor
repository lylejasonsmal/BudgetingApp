@namespace MyFirstAppComponentLibrary.UI.Components
@inject ExpenseRepository ExpenseRepository
@inject IExpenseService ExpenseService
@inject IToastService ToastService

<PopupWrapperComponent @bind-Visible="Visible" HeaderText="Edit Expense">
    
    <button class="error" @onclick="DeleteExpenseAsync">
        <MaterialDesignIconComponent IconName="delete" />
        Delete This Expense
    </button>

        @foreach (var error in _errors)
        {
            <div class="info-card error error-message">
                <h4>Error</h4>
                <p>@error</p>
            </div>
        }

        <div>
            <h6>Expense Name</h6>
            <input placeholder="Expense Name" @bind="_expense!.ExpenseName"/>
        </div>

        <div>
            <h6>Budgeted For Amount</h6>
            <input placeholder="Budgeted For Amount" type="number" step="0.01" @bind="_expense.BudgetedForAmount"/>
        </div>

        <div>
            <h6>Actual Amount</h6>
            <input placeholder="Actual Amount" type="number" step="0.01" @bind="_expense.ActualAmount"/>
        </div>

        <div>
            <h6>Notes</h6>
            <textarea placeholder="Notes" @bind="_expense.Notes"></textarea>
        </div>

    <div class="popup-actions">
        <button class="secondary-button" @onclick="CancelAsync">Cancel</button>
        <button @onclick="SaveAsync">Save</button>
    </div>
</PopupWrapperComponent>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public required int Id { get; set; }

    private ExpenseModel? _expense;

    private IList<string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        var expense = await ExpenseRepository.GetByIdAsync(Id);

        if (expense is null) return;

        _expense = expense;

        _errors = [];

        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelAsync()
    {
        _errors = [];
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task SaveAsync()
    {
        if (_expense is null) return;

        var result = await ExpenseService.UpdateExpenseAsync(_expense);

        if (result.Successful)
        {
            _errors = [];
            await VisibleChanged.InvokeAsync(false);
            await ToastService.ShowSuccessToastAsync("Successfully updated your expense.");
        }
        else if (result.Unsuccessful && result.Errors is not null)
        {
            _errors = result.Errors;
            await InvokeAsync(StateHasChanged);
            await ToastService.ShowFailureToastAsync("Process failed, try again.");
        }
    }

    private async Task DeleteExpenseAsync()
    {
        if (_expense is not null)
        {
            await ExpenseService.DeleteExpenseAsync(_expense);
            await VisibleChanged.InvokeAsync(false);
            await ToastService.ShowSuccessToastAsync("Successfully deleted your expense.");
        }
    }
}