@namespace MyFirstAppComponentLibrary.UI.Components
@inject ExpenseRepository ExpenseRepository
@inject IExpenseService ExpenseService
@inject IToastService ToastService

@if (_expense is not null)
{
    <CardWrapperComponent HeaderText="@_expense.ExpenseName" IconName="@(!_expense.IsPaidFor? "edit_note":null)" OnIconClick="OpenPopupAsync">
        <div class="main-body @(_expense.IsPaidFor ? "paid-expense" : "")">
            
            <div class="info-card @(_expense.ActualAmount > _expense.BudgetedForAmount ? "error" : "")">
                <div class="icon @(_expense.ActualAmount > _expense.BudgetedForAmount ? "error" : "")">
                    <MaterialDesignIconComponent IconName="@(_expense.ActualAmount > _expense.BudgetedForAmount ? "money_off" : "check")" />
                </div>
                <p class="secondary-text">@(_expense.ActualAmount > _expense.BudgetedForAmount ? "Above Allocated Budget" : "Within Budget")</p>
            </div>
            <div class="container">
                <div class="info-card">
                    <div>
                        <MaterialDesignIconComponent IconName="calendar_month"/>
                        <h6>
                            Budgeted
                        </h6>
                        <h1>R@_expense.BudgetedForAmount</h1>
                    </div>
                </div>

                <div class="info-card">
                    <div>
                        <MaterialDesignIconComponent IconName="calendar_today"/>
                        <h6>
                            Actual
                        </h6>
                        <h1>R@_expense.ActualAmount</h1>
                    </div>
                </div>

            </div>

            <div class="container">
                <div class="info-card">
                    <MaterialDesignIconComponent IconName="comment"/>
                    <p class="secondary-text">@_expense.Notes</p>
                </div>
            </div>
        </div>
        
        @if (!_expense.IsPaidFor)
        {
            <div class="container">
                <h6 class="secondary-text">Is this expense paid for?</h6>
                <button @onclick="TogglePaidStateAsync">Yes</button>
            </div>
        }
        else
        {
            <div class="container paid-container">
                <div class="info-card">
                    <h6 class="secondary-text">This expense is paid.</h6>
                    <button @onclick="TogglePaidStateAsync">Not Paid For Yet?</button>
                </div>
            </div>
        }
    </CardWrapperComponent>

    <EditExpensePopupComponent @bind-Visible="_showPopup" Id="_expense.Id" />
}
else
{
    <CardWrapperComponent IsLoading="true">
    </CardWrapperComponent>
}

@code {
    [Parameter] public required int Id { get; set; }
    private ExpenseModel? _expense;
    private bool _showPopup;

    protected override async Task OnParametersSetAsync()
    {
        await ExpenseService.SubscribeAsync(async _ =>
        {
            await LoadExpenseAsync();
        });
        await LoadExpenseAsync();
    }

    private async Task LoadExpenseAsync()
    {
        _expense = await ExpenseRepository.GetByIdAsync(Id);
    }

    private void OpenPopupAsync()
    {
        _showPopup = true;
    }

    private async Task TogglePaidStateAsync()
    {
        if (_expense is not null)
        {
            _expense.IsPaidFor = !_expense.IsPaidFor;
            await ExpenseService.UpdateExpenseAsync(_expense);
            if (_expense.IsPaidFor)
            {
                await ToastService.ShowSuccessToastAsync("Paid!");
            }
        }

        await LoadExpenseAsync();
    }
}