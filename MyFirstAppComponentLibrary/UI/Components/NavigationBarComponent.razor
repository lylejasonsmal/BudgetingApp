@namespace MyFirstAppComponentLibrary.UI.Components
@inject NavigationManager NavigationManager

<div id="navigation-bar" class="navigation-bar">

    <div class="navigation-container @(IsActive("/") ? "active" : "")"
         @onclick="GoToThread">
        <MaterialDesignIconComponent IconName="home" />
        @if (!IsActive("/"))
        {
            <strong id="thread-navigation-link" class="caption">Home</strong>
        }
    </div>

    <div class="navigation-container @(IsActive("/statistics-dashboard") ? "active" : "")"
         @onclick="GoToStats">
        <MaterialDesignIconComponent IconName="analytics" />
        @if (!IsActive("/statistics-dashboard"))
        {
            <strong id="stats-navigation-link" class="caption">Statistics</strong>
        }
    </div>

    <div class="navigation-container @(IsActive("/profile") ? "active" : "")"
         @onclick="GoToProfile">
        <MaterialDesignIconComponent IconName="person" />
        @if (!IsActive("/profile"))
        {
            <strong id="profile-navigation-link" class="caption">Profile</strong>
        }
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void GoToThread()
    {
        NavigationManager.NavigateTo("/");
    }

    private void GoToStats()
    {
        NavigationManager.NavigateTo("/statistics-dashboard");
    }

    private void GoToProfile()
    {
        NavigationManager.NavigateTo("/profile");
    }

    private bool IsActive(string route)
    {
        var relativePath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return relativePath == route;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}