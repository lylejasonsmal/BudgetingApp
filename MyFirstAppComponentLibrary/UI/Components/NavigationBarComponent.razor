@namespace MyFirstAppComponentLibrary.UI.Components
@inject NavigationManager NavigationManager

<div id="navigation-bar" class="navigation-bar">

    <div class="navigation-container @(IsActive("/expenses") ? "active" : "")"
         @onclick="@(() => Navigate("/expenses"))">
        <MaterialDesignIconComponent IconName="payments" />
        @if (!IsActive("/expenses"))
        {
            <strong id="thread-navigation-link" class="caption secondary-text">Expenses</strong>
        }
    </div>

    <div class="navigation-container @(IsActive("/savings") ? "active" : "")"
         @onclick="@(() => Navigate("/savings"))">
        <MaterialDesignIconComponent IconName="wallet" />
        @if (!IsActive("/savings"))
        {
            <strong id="stats-navigation-link" class="caption secondary-text">Savings</strong>
        }
    </div>

    <div class="navigation-container @(IsActive("/") ? "active" : "")"
         @onclick="@(() => Navigate("/"))">
        <MaterialDesignIconComponent IconName="home" />
        @if (!IsActive("/"))
        {
            <strong id="thread-navigation-link" class="caption secondary-text">Home</strong>
        }
    </div>

    <div class="navigation-container @(IsActive("/statistics-dashboard") ? "active" : "")"
         @onclick="@(() => Navigate("/statistics-dashboard"))">
        <MaterialDesignIconComponent IconName="dashboard_2" />
        @if (!IsActive("/statistics-dashboard"))
        {
            <strong id="stats-navigation-link" class="caption secondary-text">Statistics</strong>
        }
    </div>

    <div class="navigation-container @(IsActive("/profile") ? "active" : "")"
         @onclick="@(() => Navigate("/profile"))">
        <MaterialDesignIconComponent IconName="manage_accounts" />
        @if (!IsActive("/profile"))
        {
            <strong id="profile-navigation-link" class="caption secondary-text">Profile</strong>
        }
    </div>

</div>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void Navigate(string url)
    {
        NavigationManager.NavigateTo(url);
    }

    private bool IsActive(string route)
    {
        var relativePath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return relativePath == route;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}