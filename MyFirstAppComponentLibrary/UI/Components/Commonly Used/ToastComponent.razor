@using MyFirstApp.Domain.Helpers
@inject IToastService ToastService

@if (_showToast && _currentToast is not null)
{

    <div class="app-toast @(_currentToast.Type == ToastType.Success ? "" : "error-app-toast")">
        <div class="message-box">
            <MaterialDesignIconComponent IconName="@(_currentToast.Type == ToastType.Success ? "check_small" : "error")"/>
            <p>@_currentToast.Message</p>
        </div>

        <div @onclick="CloseOrClearToastQueueAsync">
            <MaterialDesignIconComponent IconName="close"/>
        </div>

        @if (_toastQueue.Count > 0)
        {
            <strong class="toast-queue-count">
                @_toastQueue.Count
            </strong>
        }
    </div>
}

@code {
    private bool _showToast;
    private Toast? _currentToast;

    private readonly Queue<Toast> _toastQueue = new();
    private bool _isProcessing;

    protected override async Task OnInitializedAsync()
    {
        await TaskRunner.ExecuteAsync("Initialize Toast Component", async () =>
        {
            await ToastService.SubscribeAsync(async result =>
            {
                if (_toastQueue.Count >= 3) await Task.CompletedTask;

                var toast = new Toast(
                    Message: result.Message ?? "No message",
                    Type: result.Successful ? ToastType.Success : ToastType.Error
                );

                _toastQueue.Enqueue(toast);

                _ = ProcessQueueAsync();
            });
        });
    }

    private async Task ProcessQueueAsync()
    {
        await TaskRunner.ExecuteAsync("Process Toast Queue", async () =>
        {
            if (_isProcessing)
            {
                //Refreshes toast count
                await InvokeAsync(StateHasChanged);
                return;
            }

            _isProcessing = true;

            while (_toastQueue.Count > 0)
            {
                _currentToast = _toastQueue.Dequeue();

                _showToast = true;

                await InvokeAsync(StateHasChanged);

                await Task.Delay(5000);

                _showToast = false;
                await InvokeAsync(StateHasChanged);
            }

            _isProcessing = false;
        });
    }

    private async Task CloseOrClearToastQueueAsync()
    {
        await TaskRunner.ExecuteAsync("Close Or Clear Toast Queue", async () =>
        {
            _toastQueue.Clear();
            _currentToast = null;
            _showToast = false;
            _isProcessing = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    public record Toast(string Message, ToastType Type);

    public enum ToastType
    {
        Success,
        Error
    }
}