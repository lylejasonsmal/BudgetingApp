@inject IToastService ToastService

@if (_showToast)
{
    <div class="app-toast @(_isSuccess ? "" : "error-app-toast")">
        <MaterialDesignIconComponent IconName="@(_isSuccess ? "check_small" : "error")" />
        <p>
            @_message
        </p>
    </div>
}

@code {
    private bool _showToast;
    private bool _isSuccess;
    private string? _message;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender) return;

        await ToastService.SubscribeAsync(async result =>
        {
            _isSuccess = result.Successful;
            _message = result.Message?? "No message";
            _showToast = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(5000);
            _showToast = false;
            await InvokeAsync(StateHasChanged);
        });
    }

}
