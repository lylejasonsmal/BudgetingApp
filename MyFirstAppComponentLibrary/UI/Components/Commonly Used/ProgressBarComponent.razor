@using System.Globalization

<div class="progress-container">
    <div class="progress-bar @(IsDanger? "danger" : "")" style="width:@ProgressPercentage"></div>
</div>

@code {
    [Parameter] public required double Total { get; set; }
    [Parameter] public required double Progress { get; set; }
    [Parameter] public bool IsDanger { get; set; }

    private string ProgressPercentage => Total == 0
        ? "0%"
        : ((Progress * 100) / Total).ToString("0.##", CultureInfo.InvariantCulture) + "%";
}
