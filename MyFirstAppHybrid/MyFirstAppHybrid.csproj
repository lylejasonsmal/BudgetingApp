<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<!-- Target frameworks -->
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Project info -->
		<OutputType>Exe</OutputType>
		<RootNamespace>MyFirstAppHybrid</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<Nullable>enable</Nullable>

		<ApplicationTitle>PrettyPennies</ApplicationTitle>
		<ApplicationId>com.companyname.myfirstapphybrid</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Minimum OS versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Android-specific properties -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)'=='Debug'">
		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
		<AndroidPackageFormat>aab</AndroidPackageFormat>
	</PropertyGroup>

	<!-- MAUI Assets -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#121212" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="wwwroot\**" LogicalName="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Copy RCL scoped CSS from component library to wwwroot/css -->
	<ItemGroup>
		<MauiAsset Include="..\MyFirstAppComponentLibrary\obj\$(Configuration)\net9.0\scopedcss\bundle\**\*.css" LogicalName="wwwroot\css\%(Filename)%(Extension)" />
	</ItemGroup>

	<Target Name="CopyRclScopedCss" AfterTargets="Build;Publish">
		<ItemGroup>
			<ScopedCssBundles Include="..\MyFirstAppComponentLibrary\obj\$(Configuration)\net9.0\scopedcss\bundle\**\*.css" />
		</ItemGroup>
		<Copy SourceFiles="@(ScopedCssBundles)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\css" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
	  <MauiImage Include="wwwroot\confetti.png" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="wwwroot\confetti.png" />
	</ItemGroup>

	<!-- NuGet packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
	</ItemGroup>

	<!-- Project reference to component library -->
	<ItemGroup>
		<ProjectReference Include="..\MyFirstApp.Domain\MyFirstApp.Domain.csproj" />
		<ProjectReference Include="..\MyFirstApp.Services\MyFirstApp.Services.csproj" />
		<ProjectReference Include="..\MyFirstAppComponentLibrary\MyFirstAppComponentLibrary.csproj" />
	</ItemGroup>

	<!-- Include IndexPage.xaml -->
	<ItemGroup>
		<Compile Update="IndexPage.xaml.cs">
			<DependentUpon>IndexPage.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
